// 3TEL.pipe.js
import { TEL3 } from "./3TEL.js";

export const TEL3_PIPE = {
  id: "3TEL.pipe",
  mode: "tri-synthesis",
  status: "active",

  run(segment) {
    const tri = TEL3.tri(segment);
    const quad = TEL3.quad(tri);

    const geo = this.geo(tri);
    const physik = this.physik(geo);

    return { segment, tri, quad, geo, physik };
  },

  geo(tri) {
    return {
      alpha: tri[0] === "3" ? 3 : 9,
      beta:  tri[1] === "9" ? 9 : 81,
      gamma: tri[2] === "◎" ? 81 : 27
    };
  },

  physik(geo) {
    return {
      energie: geo.alpha * 9.81,
      impuls: geo.beta * geo.gamma,
      feld: geo.gamma * 42
    };
  }
};
