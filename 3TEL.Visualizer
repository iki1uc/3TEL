<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>3TEL – Visualizer</title>
<style>
body { background:#000; color:#0f0; font-family:monospace; padding:40px; }
pre { background:#111; padding:20px; border-left:3px solid #6cf; }
</style>
</head>

<body>

<h1>3TEL – Visualizer</h1>
<pre id="out">Lade 3TEL…</pre>

<script type="module">
import { TEL3 } from "./3TEL.js";

const tri = TEL3.tri("PER");
document.getElementById("out").innerText = tri.join(" → ");
</script>

</body>
</html>
